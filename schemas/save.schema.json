{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Player Save State — Runtime Compatible",
  "type": "object",
  "required": ["version", "run_type", "season_id", "difficulty", "season_status"],
  "properties": {
    "version": {"type": "integer", "minimum": 2},
    "run_type": {"type": ["string", "null"], "enum": ["season", "tutorial", "prototype", null]},
    "season_id": {"type": ["string", "null"]},
    "season_title": {"type": ["string", "null"]},
    "episode_id": {"type": ["string", "null"]},
    "scene_id": {"type": ["string", "null"]},
    "difficulty": {
      "type": ["string", "null"],
      "enum": ["NORMAL", "Tutorial", "Standard", "Hard", "Standard-Hard", null]
    },
    "season_status": {"type": "string"},
    "world_phase": {"type": ["string", "null"]},
    "day": {"type": ["integer", "null"], "minimum": 0},
    "date": {"type": ["string", "null"]},
    "weekday": {"type": ["string", "null"]},
    "time": {"type": ["string", "null"]},
    "timeframe": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "current_objective": {"type": ["string", "null"]},
    "party_location": {"type": "object"},
    "public_party_condition": {"type": "object"},
    "family_operating_model": {"type": "object"},
    "known_assets": {"type": "object"},
    "final_assets": {"type": "object"},
    "public_world_state": {"type": "object"},
    "company_state": {"type": "object"},
    "last_choice": {},
    "checkpoint_note": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
