{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://survival-diary-archive.netlify.app/contracts/knowledge-semantic-result-v1.json",
  "title": "Knowledge Semantic Worker result v1",
  "type": "object",
  "required": [
    "version",
    "job_id",
    "decision"
  ],
  "properties": {
    "version": {
      "const": "knowledge-semantic-result-v1"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "enum": [
        "BRIEF_READY",
        "HOLD",
        "HUMAN_REVIEW"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "id",
        "brief_id",
        "topic_id",
        "status",
        "question",
        "source_kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "brief_id": {
          "type": "string",
          "minLength": 1
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "BRIEF_PROPOSED"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "source_kind": {
          "enum": [
            "PUBLIC_ARCHIVE",
            "PUBLIC_READER"
          ]
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "required": [
        "brief_id",
        "question",
        "claims"
      ],
      "properties": {
        "brief_id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "brief": {
      "type": "object",
      "required": [
        "id",
        "topic_id",
        "title",
        "content_type",
        "status",
        "risk_level",
        "publication_policy",
        "semantic_qa_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "content_type": {
          "const": "BRIEF"
        },
        "status": {
          "const": "READY"
        },
        "risk_level": {
          "type": "string",
          "minLength": 1
        },
        "publication_policy": {
          "type": "string",
          "minLength": 1
        },
        "semantic_qa_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "topic": {
      "type": "object"
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "BRIEF_READY"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "candidate",
          "evidence",
          "brief"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "code"
              ]
            },
            {
              "required": [
                "note"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "HOLD"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "code",
          "note"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "candidate"
              ]
            },
            {
              "required": [
                "evidence"
              ]
            },
            {
              "required": [
                "brief"
              ]
            },
            {
              "required": [
                "topic"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "HUMAN_REVIEW"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "required": [
          "candidate",
          "evidence",
          "brief",
          "code",
          "note"
        ]
      }
    }
  ],
  "additionalProperties": false
}
