    },
    {
      "id": "loc-wiki-b1be03144484391b40b8ecc4",
      "label": "남쪽 차량야드",
      "source": "S03 SESSION_006 GM 공개 블록 001",
      "subtitle": "길드 남쪽 차량 통행·회차 동선",
      "summary": "임관수가 현장을 관리하고 임지연이 공동권리를 가진 차량야드다. 길드는 야드 전체를 가져오지 않고 12개월 차량 통행·회차 사용권만 확보했으며 나머지는 시장에 남겼다.",
      "tags": [
        "S03",
        "장소",
        "차량야드"
      ],
      "type": "location"
    },
    {
      "id": "event-wiki-bf4768814dd7f1559d9f7496",
      "label": "남쪽 차량야드 통행·회차 사용권 합의",
      "source": "S03 SESSION_006 GM 공개 블록 001",
      "subtitle": "2027년 7월 13–20일",
      "summary": "길드는 차량야드 전체를 임대하지 않고 12개월 차량 통행·회차 사용권만 확보했다. 길드는 통로 배수·노면·방해물·소규모 파손 관리와 정기 대가를 맡고, 관수·지연은 계약 구간의 차량 통행을 보장했으며 나머지 야드는 시장에 남았다.",
      "tags": [
        "S03",
        "계약",
        "차량야드"
      ],
      "type": "event"
    },
    {
      "id": "event-wiki-d9895688b2873d713ac106cd",
      "label": "길드 거래 책임범위 공개",
      "source": "S03 SESSION_006 GM 공개 블록 003",
      "subtitle": "2027년 7월 21일",
      "summary": "길드는 중개한 거래, 에스크로를 받은 거래, 직접 운영한 서비스는 기록된 약속 범위에서 책임지고, 시장 바깥이나 주변 점포의 당사자 직접거래는 보증하지 않는다고 공개했다.",
      "tags": [
        "S03",
        "길드",
        "거래규칙"
      ],
      "type": "event"
    },
    {
      "id": "event-wiki-37bff157632c4ca2e1e99420",
      "label": "한재욱 곡물 직접거래 분쟁",
      "source": "S03 SESSION_006 GM 공개 블록 003",
      "subtitle": "2027년 7월 24일",
      "summary": "길드 밖 직접거래한 곡물에서 문제가 생겼지만 에스크로·중개·검수가 없어 길드는 배상하지 않았다. 길드는 한재욱에게 길드 이름을 거래 신용처럼 끌어다 쓰지 말라고 선을 그었다.",
      "tags": [
        "S03",
        "분쟁",
        "자유거래"
      ],
      "type": "event"
    },
    {
      "id": "event-wiki-6fa152109f3897e4ad04b372",
      "label": "길드 거래 서비스 구분 검토",
      "source": "S03 SESSION_006 GM 공개 블록 005",
      "subtitle": "2027년 8월 4일",
      "summary": "관리동 논의에서 등록상인은 사람과 이력 확인, 에스크로는 정해진 거래 과정 관리, 보증거래는 특정 거래 결과조건까지 책임범위를 넓히는 구조로 구분했다.",
      "tags": [
        "S03",
        "길드",
        "거래서비스"
      ],
      "type": "event"
    },
    {
      "id": "event-wiki-111fe570a078504a9c47714f",
      "label": "길드 직매입·검수·재판매 사업 재정의",
      "source": "S03 SESSION_006 GM 공개 블록 007, 011",
      "subtitle": "2027년 8월 5일",
      "summary": "등록상인은 보류하고 에스크로는 유지하며, 보증거래는 폐기해 길드가 물건을 직접 매입·검수·수리·재판매하는 모델로 재정의했다. 길드는 검사·수리·지속수요 기준을 충족하는 물건만 사고 기준 밖이면 매입하지 않는 원칙을 세웠다.",
      "tags": [
        "S03",
        "길드",
        "직매입",
        "표준품"
      ],
      "type": "event"
    },
    {
      "id": "event-wiki-ad8b8dbcdc75bcabfcae2cf7",
      "label": "길드 표준품 후보 관찰기간",
      "source": "S03 SESSION_006 GM 공개 블록 009",
      "subtitle": "2027년 8월 6–28일",
      "summary": "길드는 직매입 사업을 바로 열지 않고 실제 거래가격·고장·수리·부품·구매문의·판매기간을 기록했다. 급수·배관은 반복수요, 표준화 가능성, 미판매 재고의 자체 사용가치가 높았고, 길드의 구매의사 자체가 시장가격에 영향을 주는 점도 확인됐다.",
      "tags": [
        "S03",
        "길드",
        "시장관찰",
        "표준품"
      ],
      "type": "event"
    },
    {
      "id": "event-wiki-a93db7854c7049a3b7c936b2",
      "label": "길드 표준펌프 1호",
      "source": "S03 SESSION_006 GM 공개 블록 013",
      "subtitle": "2027년 9월 19–22일",
      "summary": "길드 표준펌프 1호 사업이 시작됐다. 공개 매입가 대신 내부 상한을 두고 지정 규격과 수리조건을 통과한 물건만 기존 기준가로 매입했으며 첫 판매용 두 대를 완성했다. 표준품 가치는 기술력·부품재고·검수기록·수리능력·사후 신뢰를 더하는 데서 만들어졌다.",
      "tags": [
        "S03",
        "길드",
        "표준품",
        "급수"
      ],
      "type": "event"
    }
