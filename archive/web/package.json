{
  "name": "survival-diary-archive",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/build-knowledge.mjs --check && node ../scripts/knowledge-scan.mjs --check && tsc --noEmit && vite build && node ../scripts/write-deploy-meta.mjs",
    "build:verified": "npm run reader:check && npm run build",
    "test": "vitest run",
    "reader:build": "node ../scripts/build-reader-edition.mjs",
    "reader:check": "node ../scripts/check-reader-edition.mjs",
    "knowledge:build": "node ../scripts/build-knowledge.mjs",
    "knowledge:check": "node ../scripts/build-knowledge.mjs --check && node ../scripts/knowledge-scan.mjs --check",
    "knowledge:test": "node --test ../scripts/lib/knowledge.test.mjs ../scripts/lib/knowledge-experience.test.mjs",
    "knowledge:semantic:test": "node --test ../scripts/lib/knowledge-semantic-jobs.test.mjs ../scripts/lib/knowledge-semantic-finalizer.test.mjs",
    "knowledge:publish-prepare": "node ../scripts/knowledge-publish-prepare.mjs",
    "knowledge:review-sync": "node ../scripts/knowledge-review-sync.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
