{
  "version": "illustration-native-worker-runtime-contract-v1.5",
  "purpose": "Regular reservation Coordinator: dispatch/collect, then existing review/transfer, one role per run. Visual-only one-shot Renderer writes Library. Program owns Prep, durable review mutation and Finalizer.",
  "roles": {
    "PREPARED": {
      "role": "DISPATCH_OR_COLLECT",
      "one_role_per_run": true,
      "next_status": "INGESTING",
      "owner": "RESERVATION_COORDINATOR",
      "route_helper": "archive/scripts/illustration-reservation-bridge.mjs route"
    },
    "INGESTING": {
      "role": "REVIEWER",
      "decision_transport": "GITHUB_RUNTIME_HANDOFF",
      "decision_rpc": "archive_illustration_review_decide_v3",
      "decision_rpc_owner": "PROGRAM_REVIEW_HANDOFF",
      "decision_before_transfer": true,
      "outcomes": {
        "PASS": "REVIEW_PASS_STAGED",
        "REJECT": "REVIEW_REJECTED",
        "HUMAN_REVIEW": "HUMAN_REVIEW"
      },
      "one_role_per_run": true,
      "stop_after_handoff_commit": true,
      "owner": "RESERVATION_COORDINATOR"
    },
    "REVIEW_PASS_STAGED": {
      "role": "PASS_SITE_ASSET_TRANSFER",
      "re_review": false,
      "next_status": "FINALIZE_QUEUED",
      "one_role_per_run": true,
      "stop_after_status_transition": true,
      "owner": "RESERVATION_COORDINATOR"
    }
  },
  "source": {
    "library_path": "/IMAGE-RENDER/output/current.png",
    "generated_format": "image/png",
    "stale_replacement_rule": "A PREPARED job may replace current.png only when its modified_at is earlier than the current job created_at. A same-job file is resumed without regeneration."
  },
  "review_handoff": {
    "version": "illustration-review-handoff-v1",
    "branch": "automation-b-review-handoff",
    "path": "archive/automation/runtime/illustration-review-handoff.json",
    "workflow": ".github/workflows/archive-illustration-review-handoff.yml",
    "program": "archive/scripts/apply-illustration-review-handoff.mjs",
    "ai_direct_db_mutation": false,
    "program_acquires_fresh_lease": true,
    "program_uses_current_main_code": true
  },
  "pass_asset": {
    "format": "image/png",
    "width": 512,
    "height": 512,
    "conversion": "RGB -> LANCZOS 512x512 -> 256-color quantize -> optimize; if >200000 bytes retry 128-color",
    "max_bytes": 1000000,
    "preferred_chunk_b64_chars": 220000,
    "max_chunks": 8,
    "staging_begin_rpc": "archive_illustration_site_staging_begin",
    "staging_resume_rpc": "archive_illustration_review_staging_resume",
    "chunk_put_rpc": "archive_illustration_review_staging_chunk_put",
    "staging_finalize_rpc": "archive_illustration_site_staging_finalize"
  },
  "reject": {
    "binary_transfer": false,
    "library_cleanup_after_durable_decision": false,
    "stale_library_source_replaced_by_next_prepared_renderer": true
  },
  "human_review": {
    "binary_transfer": false,
    "preserve_library_source": true
  },
  "vault": {
    "current_runtime": false,
    "legacy_functions_retained_for_old_jobs_only": true
  },
  "program_owners": {
    "prep": "Supabase/GitHub Program Prep",
    "review_decision": "GitHub Program Review Handoff",
    "finalizer": "Existing GitHub Program Finalizer"
  },
  "selection_policy": {
    "automatic": "eligible CHARACTER only; never-attempted CHARACTER before retried CHARACTER; LOCATION/EVENT deferred while eligible CHARACTER exists",
    "manual_subject_override": true,
    "durable_attempt_history_rpc": "archive_illustration_render_attempt_history"
  },
  "renderer_context_isolation": {
    "enabled": true,
    "rule": "Separate scheduled Renderer gets only exact visual prompt and RESERVATION_RENDER_SUFFIX.",
    "allowed_before_image_call": [
      "EXACT_VISUAL_PROMPT",
      "FIXED_LIBRARY_SAVE_SUFFIX"
    ],
    "scene_input": "BYTE_EQUIVALENT_DB_PROMPT_PLUS_RESERVATION_RENDER_SUFFIX",
    "authority": "archive/scripts/lib/illustration-reservation-handoff.mjs"
  },
  "workers": {
    "reservation_coordinator": {
      "boot_router": "docs/automation/ILLUSTRATION_B_NATIVE_WORKER_ROUTER.md",
      "task_id": "6ac24401ee1881919ac19b158102b752",
      "handles": [
        "PREPARED",
        "INGESTING",
        "REVIEW_PASS_STAGED"
      ],
      "one_role_per_run": true,
      "forbidden": [
        "IMAGE_GENERATION",
        "DIRECT_REVIEW_DB_MUTATION",
        "PROGRAM_FINALIZER"
      ]
    },
    "isolated_renderer": {
      "task_id": "6ac2e58fc3848191aba731468f6c3e18",
      "recurring": false,
      "prompt_builder": "buildReservationRendererPrompt",
      "responsibilities": [
        "NATIVE_IMAGE_GENERATION",
        "LIBRARY_WRITE"
      ],
      "forbidden": [
        "OPERATIONAL_CONTEXT",
        "DB",
        "REVIEW",
        "BINARY_TRANSFER",
        "FINALIZER"
      ]
    },
    "legacy_workers": {
      "enabled": false,
      "preserve_off_task_ids": [
        "6ac252c96ea88191841241364adafb82",
        "6ac234656c0481918269852a2ada19fc"
      ]
    }
  }
}
