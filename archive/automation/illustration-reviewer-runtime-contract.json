{
  "version": "illustration-reviewer-runtime-contract-v2",
  "lease_acquire": {
    "rpc": "archive_illustration_render_job_lease_acquire",
    "request": {
      "p_job_id": "<job_id>",
      "p_owner": "chatgpt-reviewer-<run-id>",
      "p_lease_seconds": 600
    },
    "required_response": {
      "status": "LEASE_ACQUIRED",
      "lease_token": "<uuid>",
      "lease_until": "<timestamp>"
    },
    "allowed_job_statuses": [
      "PREPARED",
      "INGESTING",
      "READY_FOR_REVIEW"
    ],
    "lease_held_behavior": "Stop this run without mutating the job. Do not reuse another run's token."
  },
  "mutations": [
    {
      "rpc": "archive_illustration_review_staging_begin",
      "request": {
        "p_meta": {
          "job_id": "<job_id>",
          "lease_token": "<lease_token_from_acquire>",
          "staging_id": "<staging_id>",
          "point_id": "<point_id>",
          "generation_key": "<generation_key>",
          "subject_id": "<subject_id>",
          "source_sha256": "<sha256>",
          "byte_count": 1,
          "width": 1,
          "height": 1,
          "mime_type": "image/png",
          "chunk_count": 1,
          "provider_asset_id": "<provider_asset_id>"
        }
      },
      "required_job_status": "PREPARED",
      "token_path": "p_meta.lease_token"
    },
    {
      "rpc": "archive_illustration_review_staging_chunk_put",
      "request": {
        "p_job_id": "<job_id>",
        "p_lease_token": "<lease_token_from_acquire>",
        "p_staging_id": "<staging_id>",
        "p_chunk_index": 0,
        "p_chunk_b64": "<base64_chunk>"
      },
      "required_job_status": [
        "PREPARED",
        "INGESTING",
        "READY_FOR_REVIEW"
      ],
      "token_path": "p_lease_token"
    },
    {
      "rpc": "archive_illustration_review_staging_finalize",
      "request": {
        "p_job_id": "<job_id>",
        "p_lease_token": "<lease_token_from_acquire>",
        "p_staging_id": "<staging_id>"
      },
      "required_job_status": [
        "PREPARED",
        "INGESTING",
        "READY_FOR_REVIEW"
      ],
      "token_path": "p_lease_token"
    },
    {
      "rpc": "archive_illustration_review_complete",
      "request": {
        "p_review": {
          "job_id": "<job_id>",
          "lease_token": "<lease_token_from_acquire>",
          "decision": "<PASS|REJECT|HUMAN_REVIEW>",
          "review_provider": "native_chatgpt_vision",
          "output_sha256": "<sha256>",
          "output_bytes": 1,
          "output_width": 1,
          "output_height": 1,
          "rejection_codes": [],
          "review_context_sha256": "<exact_context_hash>",
          "review_staging_id": "<staging_id>",
          "provider_asset_id": "<provider_asset_id>"
        }
      },
      "required_job_status": "PREPARED",
      "token_path": "p_review.lease_token",
      "context_hash_path": "p_review.review_context_sha256",
      "required_fields": [
        "review_staging_id",
        "provider_asset_id"
      ]
    }
  ],
  "decision_lifecycle": {
    "HUMAN_REVIEW": {
      "final_status": "HUMAN_REVIEW",
      "lease_owner": null,
      "lease_token": null,
      "lease_until": "decision_time + 7 days",
      "worker_may_acquire_during_sla": false,
      "attempt_no_effect": "Unchanged",
      "vault": "REQUIRED_30_DAY_PRIVATE_ARCHIVE"
    },
    "REJECT": {
      "final_status": "REVIEW_REJECTED",
      "lease_owner": null,
      "lease_token": null,
      "lease_until": null,
      "attempt_no_effect": "The current attempt_no is unchanged; only a later queued semantic retry receives the next attempt number.",
      "vault": "REQUIRED_30_DAY_PRIVATE_ARCHIVE"
    },
    "PASS": {
      "final_status": "FINALIZE_QUEUED",
      "lease_owner": null,
      "lease_token": null,
      "lease_until": null,
      "next_owner": "Program Finalizer must acquire a fresh lease before mutation.",
      "vault": "REQUIRED_30_DAY_PRIVATE_ARCHIVE_AND_EXISTING_PERMANENT_PROMOTION"
    }
  },
  "rollout_dependency": {
    "reviewer_update_required": true,
    "current_reservation_compatible": true
  },
  "binding_snapshot": {
    "required_fields": [
      "job_id",
      "attempt_no",
      "point_id",
      "generation_key",
      "subject_id",
      "prompt_sha256",
      "review_context_version",
      "review_context_sha256"
    ],
    "authority": "job.review_context"
  },
  "review_context_authority": {
    "version": "illustration-review-context-v1",
    "context_path": "job.review_context",
    "hash_path": "job.review_context_sha256",
    "canon_facts": "CONFIRMED_PUBLIC_CANON",
    "render_cues": "ALLOWED_NOT_REQUIRED_NOT_NEW_CANON"
  },
  "legacy_compatibility": {
    "null_context_hash": "PRE_V2_PATH_ALLOWED"
  },
  "visual_quality_policy": {
    "incidental_text_and_interface": {
      "automatic_reject": false,
      "pass_when": [
        "small_or_contextual",
        "legible_or_visually_coherent",
        "not_composition_dominant",
        "does_not_create_unsupported_canon_or_identity"
      ],
      "reject_when": [
        "garbled_or_malformed_text",
        "nonsensical_repeated_glyphs",
        "dominant_fake_ui_or_text_layout",
        "specific_text_or_label_creates_unsupported_story_fact_or_identity",
        "intrusive_watermark_or_generation_artifact"
      ]
    }
  },
  "review_staging_policy": {
    "required_for_every_decision": true,
    "order": [
      "acquire_lease",
      "bind_exact_job_and_review_context",
      "materialize_and_hash_current_png",
      "resume_exact_staging_or_begin_only_after_binary_preflight",
      "upload_only_missing_chunks_and_finalize_exact_png",
      "perform_visual_review",
      "submit_PASS_REJECT_or_HUMAN_REVIEW"
    ],
    "reason": "Every generated render must enter the 30-day private illustration vault, including rejected and human-review outputs."
  },
  "vault": {
    "storage_bucket": "survival-illustration-vault",
    "visibility": "PRIVATE_OPERATOR_ONLY",
    "retention_days": 30,
    "cleanup_owner": "Program Prep",
    "ai_schedule_added": false,
    "pass_behavior": "Keep a temporary vault copy while the accepted original also proceeds through the existing permanent Storage/Registry/SITE_ASSETS pipeline.",
    "reject_behavior": "Keep only the temporary vault copy; remove transport staging after the vault upload succeeds.",
    "human_review_behavior": "Keep only the temporary vault copy unless later approved through a separate operator flow."
  },
  "staging_transport": {
    "source_path": "/AFTERFALL-B/render-output/current.png",
    "source_acquisition": "FILES_LIBRARY_RAW_MATERIALIZE",
    "preview_or_image_asset_pointer_is_not_binary_transport": true,
    "encoding": "base64",
    "preferred_chunk_b64_chars": 220000,
    "hard_max_chunk_b64_chars": 240000,
    "precondition": "Materialize the exact Library PNG to local raw bytes and compute SHA-256, byte count, width, height and chunk_count before calling staging_begin.",
    "provider_asset_id": "Use the exact Library backing file id as chatgpt-library:<file_id> when no more specific native generation asset id is available.",
    "resume_rpc": "archive_illustration_review_staging_resume",
    "abort_rpc": "archive_illustration_review_staging_abort",
    "resume_behavior": "If an existing UPLOADING staging row matches the exact job/point/generation/subject/SHA/bytes/dimensions/provider_asset_id, reuse its staging_id even if its naming predates the current convention and upload only missing chunk indexes.",
    "ready_behavior": "If the exact staging is already READY, do not upload again; continue to visual review.",
    "conflict_behavior": "Never overwrite a mismatched staging row. Abort is allowed only for the same leased job, exact staging_id, exact source_sha256 and UPLOADING status; then begin a fresh exact staging.",
    "partial_failure_behavior": "Preserve exact matching chunks for a later resume. Never create a second staging row for the same job.",
    "chunk_execution": "Generate and submit one base64 chunk at a time from the materialized local file; do not place the full-file base64 into repository files, prompts, logs or user-visible output."
  }
}
